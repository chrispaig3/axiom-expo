; src/Commands - expo subcommand parsing and `gh` batches.
(import IO)
(import Str)
(import Vec)
(import Sys)
(import Err)
(import Fmt)
(import Par)
(import Mem)
(import Lib.Types)
(import Lib.Validate)
(import Lib.Gh)

; Collect non-flag argv slots in order. Used by delete/archive and by
; visibility for the slots after the state word.
;@axiom:effect(io)
(pub :: collectLenient (-> Int Int (Vec String)))
(pub fn (collectLenient from n)
  (let ((out vecNew))
    {
      (collectLenientFrom from n out)
      out
    }))

;@axiom:effect(io)
(pub :: collectLenientFrom (-> Int Int (Vec String) Int))
(pub fn (collectLenientFrom i n out)
  (if (>= i n)
    0
    {
      (let ((a (sysArg i)))
        (if (isFlag a)
          0
          {
            (vecPush out a)
            0
          }))
      (collectLenientFrom (+ i 1) n out)
    }))

; True when the exact flag word appears anywhere in [from, n).
;@axiom:effect(io)
(pub :: hasFlag (-> String Int Int Bool))
(pub fn (hasFlag want from n)
  (if (>= from n)
    false
    (if (strEq (sysArg from) want)
      true
      (hasFlag want (+ from 1) n))))

; Single-quote a shell word: 'abc' -> ''abc'', with embedded ' as '\''.
;@axiom:restrict(no-io,no-foreign)
(pub :: shellQuote (-> String String))
(pub fn (shellQuote s) (shellQuoteFrom s 0 (strConcat "'" "")))

;@axiom:restrict(no-io,no-foreign)
(pub :: shellQuoteFrom (-> String Int String String))
(pub fn (shellQuoteFrom s i acc)
  (if (>= i (strLen s))
    (strConcat acc "'")
    (if (== (strByte s i) 39)
      (shellQuoteFrom s (+ i 1) (strConcat acc "'\\''"))
      (shellQuoteFrom s (+ i 1) (strConcat acc (strSlice s i 1))))))

; Quote every argv element and join with spaces for `sh -c`.
(pub :: argvToShell (-> (Vec String) String))
(pub fn (argvToShell argv)
  (argvToShellFrom argv 0 (vecLen argv) ""))

(pub :: argvToShellFrom (-> (Vec String) Int Int String String))
(pub fn (argvToShellFrom argv i n acc)
  (if (>= i n)
    acc
    (let ((q (shellQuote (vecGetStr argv i))))
      (if (== i 0)
        (argvToShellFrom argv (+ i 1) n q)
        (argvToShellFrom argv (+ i 1) n (strConcat (strConcat acc " ") q))))))

; Wrap a gh argv Vec as `sh -c "<quoted> <redir>"` so child stdio never
; reaches expo's own descriptors.
(pub :: shWrap (-> (Vec String) String (Vec String)))
(pub fn (shWrap argv redir)
  (let ((v vecNew))
    {
      (vecPush v "sh")
      (vecPush v "-c")
      (vecPush v (strConcat (argvToShell argv) redir))
      v
    }))

; delete --yes batch: one `gh api -X DELETE` per valid repo through the
; bounded Par pool. Submit order is kept for stable output.
;@axiom:effect(io)
(pub :: runBatchDelete (-> (Vec String) Int))
(pub fn (runBatchDelete repos)
  (region batch
    (let ((ctr (Counter 0)) (n (vecLen repos)))
      {
        (let ((cmds vecNew) (mut i 0))
          {
            (while (< i n)
              {
                (let ((r (vecGetStr repos i)))
                  (if (isValidRepo r)
                    (vecPush cmds (shWrap (ghDeleteArgv r) " > /dev/null 2> /dev/null"))
                    (let ((skip vecNew))
                      {
                        (vecPush skip "/usr/bin/true")
                        (vecPush cmds skip)
                      })))
                (set i (+ i 1))
              })
            (let ((codes (parRunAll cmds 8)) (mut k 0))
              {
                (while (< k n)
                  {
                    (let ((r (vecGetStr repos k)) (c (cast Int (vecGet codes k))))
                      (if (isValidRepo r)
                        (if (== c 0)
                          {
                            (println "Repository {r} deleted.")
                            (set ctr.n (+ ctr.n 1))
                            0
                          }
                          0)
                        0))
                    (set k (+ k 1))
                  })
                ctr.n
              })
          })
      })))

; visibility batch: `gh api -X PATCH -f private=B` per valid repo.
;@axiom:effect(io)
(pub :: runBatchVisibility (-> (Vec String) VisState Int))
(pub fn (runBatchVisibility repos vs)
  (region batch
    (let ((ctr (Counter 0)) (n (vecLen repos)))
      {
        (let ((cmds vecNew) (mut i 0))
          {
            (while (< i n)
              {
                (let ((r (vecGetStr repos i)))
                  (if (isValidRepo r)
                    (let ((priv (match vs ((Public) false) ((Private) true))))
                      (vecPush cmds (shWrap (ghPrivateArgv r priv) " > /dev/null 2> /dev/null")))
                    (let ((skip vecNew))
                      {
                        (vecPush skip "/usr/bin/true")
                        (vecPush cmds skip)
                      })))
                (set i (+ i 1))
              })
            (let ((codes (parRunAll cmds 8)) (mut k 0))
              {
                (while (< k n)
                  {
                    (let ((r (vecGetStr repos k)) (c (cast Int (vecGet codes k))))
                      (if (isValidRepo r)
                        (if (== c 0)
                          {
                            (match vs
                              ((Public) (println "Repository {r} visibility changed to Public."))
                              ((Private) (println "Repository {r} visibility changed to Private.")))
                            (set ctr.n (+ ctr.n 1))
                            0
                          }
                          0)
                        0))
                    (set k (+ k 1))
                  })
                ctr.n
              })
          })
      })))

; archive batch: `gh api -X PATCH -f archived=B` per valid repo.
;@axiom:effect(io)
(pub :: runBatchArchive (-> (Vec String) Bool Int))
(pub fn (runBatchArchive repos doArchive)
  (region batch
    (let ((ctr (Counter 0)) (n (vecLen repos)))
      {
        (let ((cmds vecNew) (mut i 0))
          {
            (while (< i n)
              {
                (let ((r (vecGetStr repos i)))
                  (if (isValidRepo r)
                    (vecPush cmds (shWrap (ghArchivedArgv r doArchive) " > /dev/null 2> /dev/null"))
                    (let ((skip vecNew))
                      {
                        (vecPush skip "/usr/bin/true")
                        (vecPush cmds skip)
                      })))
                (set i (+ i 1))
              })
            (let ((codes (parRunAll cmds 8)) (mut k 0))
              {
                (while (< k n)
                  {
                    (let ((r (vecGetStr repos k)) (c (cast Int (vecGet codes k))))
                      (if (isValidRepo r)
                        (if (== c 0)
                          {
                            (if doArchive
                              (println "Repository {r} archived.")
                              (println "Repository {r} unarchived."))
                            (set ctr.n (+ ctr.n 1))
                            0
                          }
                          0)
                        0))
                    (set k (+ k 1))
                  })
                ctr.n
              })
          })
      })))

; delete handler: dry-run in order, or concurrent `gh` with --yes.
; Validation runs before auth, matching the reference routing.
;@axiom:effect(io)
(pub :: runDelete (-> Int Int Int))
(pub fn (runDelete from n)
  (let ((repos (collectLenient from n)) (yes (hasFlag "--yes" from n)))
    (if (== (vecLen repos) 0)
      {
        (eprintln "Error: delete requires at least one repository")
        1
      }
      (if (!= (doAuth) 0)
        1
        (if yes
          {
            (runBatchDelete repos)
            0
          }
          (region dry
            (let ((mut i 0))
              {
                (while (< i (vecLen repos))
                  {
                    (let ((r (vecGetStr repos i)))
                      (if (isValidRepo r)
                        (println "Dry run: not deleting repository {r}. Use --yes to actually delete.")
                        0))
                    (set i (+ i 1))
                  })
                0
              })))))))

; visibility handler: state is argv[from] exactly, then lenient repos.
;@axiom:effect(io)
(pub :: runVisibility (-> Int Int Int))
(pub fn (runVisibility from n)
  (if (>= from n)
    {
      (eprintln "Error: visibility requires a visibility state and at least one repository")
      1
    }
    (let ((st (sysArg from)))
      (match (parseVis st)
        ((None)
          {
            (eprintln "Error: visibility must be 'public' or 'private'")
            1
          })
        ((Some vs)
          (let ((repos (collectLenient (+ from 1) n)))
            (if (== (vecLen repos) 0)
              {
                (eprintln "Error: visibility requires a visibility state and at least one repository")
                1
              }
              (if (!= (doAuth) 0)
                1
                {
                  (runBatchVisibility repos vs)
                  0
                }))))))))

; archive handler: --unarchive flips the archived bit.
;@axiom:effect(io)
(pub :: runArchive (-> Int Int Int))
(pub fn (runArchive from n)
  (let ((repos (collectLenient from n)) (un (hasFlag "--unarchive" from n)))
    (if (== (vecLen repos) 0)
      {
        (eprintln "Error: archive requires at least one repository")
        1
      }
      (if (!= (doAuth) 0)
        1
        {
          (runBatchArchive repos (if un false true))
          0
        }))))

; create handler: strict flags, sequential fail-fast.
;@axiom:effect(io)
(pub :: runCreate (-> Int Int Int))
(pub fn (runCreate from n)
  (region cparse
    (let ((repos vecNew) (mut isPublic false) (mut desc (DNone)) (mut haveDesc false) (mut i from) (mut bad ""))
      {
        (while (< i n)
          (let ((a (sysArg i)))
            (if (strEq a "--public")
              {
                (set isPublic true)
                (set i (+ i 1))
              }
              (if (strEq a "--description")
                (if (>= (+ i 1) n)
                  {
                    (eprintln "Error: --description requires a value")
                    (set bad "__desc_missing__")
                    (set i n)
                  }
                  {
                    (if haveDesc
                      0
                      {
                        (set desc (DSome (sysArg (+ i 1))))
                        (set haveDesc true)
                        0
                      })
                    (set i (+ i 2))
                  })
                (if (isFlag a)
                  {
                    (set bad a)
                    (set i n)
                  }
                  {
                    (vecPush repos a)
                    (set i (+ i 1))
                  })))))
        (if (strEq bad "__desc_missing__")
          1
          (if (!= (strLen bad) 0)
            {
              (eprintln "Error: unknown option '{bad}'")
              1
            }
            (if (== (vecLen repos) 0)
              {
                (eprintln "Error: create requires at least one repository")
                1
              }
              (if (!= (doAuth) 0)
                1
                (createSeq repos isPublic desc 0)))))
      })))

; Sequential create loop with InvalidRepository checks.
;@axiom:effect(io)
(pub :: createSeq (-> (Vec String) Bool (DescOpt String) Int Int))
(pub fn (createSeq repos isPublic descOpt idx)
  (if (>= idx (vecLen repos))
    0
    (let ((r (vecGetStr repos idx)))
      (if (isValidRepo r)
        (let ((res (runCreateOne r isPublic descOpt)))
          (let ((code res.fst) (msg res.snd))
            (if (== code 0)
              {
                (println "Repository {r} created successfully.")
                (createSeq repos isPublic descOpt (+ idx 1))
              }
              (if (== code 1)
                {
                  (eprintln "Repository {r} already exists")
                  (eprintln "Error: GitHubCommandFailed")
                  1
                }
                {
                  (let ((clean (trimErr msg)))
                    {
                      (eprintln "Failed to create repository {r}: {clean}")
                      (eprintln "")
                      (eprintln "Error: GitHubCommandFailed")
                      1
                    })
                }))))
        {
          (eprintln "Error: InvalidRepository(\"{r}\")")
          1
        }))))

; One create through sh with stdout dropped and stderr captured to a
; pid-unique temp file. Single `gh` invocation.
; Answers Pair(code, stderr): 0 ok, 1 already-exists, 2 other failure.
;@axiom:effect(io)
(pub :: runCreateOne (-> String Bool (DescOpt String) (Pair Int String)))
(pub fn (runCreateOne repo isPublic descOpt)
  (let ((tmp (strConcat "/tmp/expo-err-" (fmtInt (sysGetPid)))))
    (let ((cmd (createShell repo isPublic descOpt tmp)))
      (let ((shargs vecNew))
        {
          (vecPush shargs "sh")
          (vecPush shargs "-c")
          (vecPush shargs cmd)
          (let ((rc (runGh shargs)))
            (let ((err (readFile tmp)))
              {
                (removeFile tmp)
                (if (!= rc 0)
                  (if (containsSub err "already exists")
                    (Pair 1 err)
                    (Pair 2 err))
                  (Pair 0 err))
              }))
        }))))

; Shell line for one create: stdout to /dev/null, stderr to tmp.
(pub :: createShell (-> String Bool (DescOpt String) String String))
(pub fn (createShell repo isPublic descOpt tmp)
  (let ((base (strConcat (strConcat "gh api -X POST user/repos -f name=" (shellQuote (repoName repo))) (if isPublic " -f private=false" " -f private=true"))))
    (let ((withDesc
      (match descOpt
        ((DNone) base)
        ((DSome d) (strConcat (strConcat base " -f description=") (shellQuote d))))))
      (strConcat (strConcat withDesc " > /dev/null 2> ") (shellQuote tmp)))))
