; Lib/Gh - `gh` argv construction and auth probe for expo.
(import IO)
(import Str)
(import Vec)
(import Sys)
(import Err)
(import Fmt)
(import Par)
(import Lib.Types)
(import Lib.Validate)

; gh auth status -h github.com
(pub :: ghAuthArgv (Vec String))
(pub fn (ghAuthArgv)
  (let ((v vecNew))
    {
      (vecPush v "gh")
      (vecPush v "auth")
      (vecPush v "status")
      (vecPush v "-h")
      (vecPush v "github.com")
      v
    }))

; gh api -X DELETE repos/R
(pub :: ghDeleteArgv (-> String (Vec String)))
(pub fn (ghDeleteArgv repo)
  (let ((v vecNew))
    {
      (vecPush v "gh")
      (vecPush v "api")
      (vecPush v "-X")
      (vecPush v "DELETE")
      (vecPush v (strConcat "repos/" repo))
      v
    }))

; gh api -X PATCH repos/R -f private=B
(pub :: ghPrivateArgv (-> String Bool (Vec String)))
(pub fn (ghPrivateArgv repo isPrivate)
  (let ((v vecNew))
    {
      (vecPush v "gh")
      (vecPush v "api")
      (vecPush v "-X")
      (vecPush v "PATCH")
      (vecPush v (strConcat "repos/" repo))
      (vecPush v "-f")
      (vecPush
        v
        (if isPrivate
          "private=true"
          "private=false"))
      v
    }))

; gh api -X PATCH repos/R -f archived=B
(pub :: ghArchivedArgv (-> String Bool (Vec String)))
(pub fn (ghArchivedArgv repo doArchive)
  (let ((v vecNew))
    {
      (vecPush v "gh")
      (vecPush v "api")
      (vecPush v "-X")
      (vecPush v "PATCH")
      (vecPush v (strConcat "repos/" repo))
      (vecPush v "-f")
      (vecPush
        v
        (if doArchive
          "archived=true"
          "archived=false"))
      v
    }))

; gh api -X POST user/repos -f name=N -f private=B [-f description=D].
; N is the text after '/'; D is the first --description only.
(pub :: ghCreateArgv (-> String Bool (DescOpt String) (Vec String)))
(pub fn (ghCreateArgv repo isPublic descOpt)
  (let ((v vecNew))
    {
      (vecPush v "gh")
      (vecPush v "api")
      (vecPush v "-X")
      (vecPush v "POST")
      (vecPush v "user/repos")
      (vecPush v "-f")
      (vecPush v (strConcat "name=" (repoName repo)))
      (vecPush v "-f")
      (vecPush
        v
        (if isPublic
          "private=false"
          "private=true"))
      (match descOpt
        ((DNone) 0)
        ((DSome d)
          {
            (vecPush v "-f")
            (vecPush v (strConcat "description=" d))
          }
        ))
      v
    }))

; Run one argv via PATH. >=0 is the exit code, <0 is spawn errno.
;@axiom:effect(io)
(pub :: runGh (-> (Vec String) Int))
(pub fn (runGh argv)
  (match (parRunOne argv)
    ((Ok c) c)
    ((Err e) (- 0 (errCode e)))))

; Auth probe with child stdio dropped. Prints the auth line with
; reference routing: success to stdout, failures to stderr.
; Answers 0 ok, 1 bad credentials, 2 spawn failure.
;@axiom:effect(io)
(pub :: doAuth Int)
(pub fn (doAuth)
  (let ((shargs vecNew))
    {
      (vecPush shargs "sh")
      (vecPush shargs "-c")
      (vecPush shargs "gh auth status -h github.com > /dev/null 2> /dev/null")
      (match (parRunOne shargs)
        ((Ok c)
          (if (== c 0)
            {
              (println "Authentication successful.")
              0
            }
            {
              (eprintln "Error: AuthenticationFailed")
              1
            })
        )
        ((Err _)
          {
            (eprintln "Error: CommandExecution")
            2
          }
        ))
    }))
